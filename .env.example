# ImageInt configuration. Copy to .env and adjust.
#
#   cp .env.example .env
#   docker compose up -d
#
# Every variable has a working default, so an empty .env also starts.
#
# ── Reference machine ────────────────────────────────────────────────────────
# Dimensioned for:
#     at least 8 CPU cores with AVX2 (x86-64) and at least 32 GB RAM
# That is exactly what the gateway checks at startup and reports under
# GET /v1/config in the "host" field. AVX-512 is detected as well, but - unlike
# AVX2 - it is not a blocker: the service runs without AVX-512, just slower. On
# a virtual machine or in a container a missing AVX2 is only warned about
# instead of rejected, see IMAGEINT_HOST_CHECK below.
#
# ── Memory ───────────────────────────────────────────────────────────────────
# The image model runs in bf16, the format the model card documents:
#
#     image     Qwen-Image-2.1 bf16   ~33 GB  (text encoder 17.5 GB,
#                                              DiT 14 GB, VAE 1.35 GB)
#     enhancer  PE-T2I bf16           ~19 GB  (+ ~2 GB KV cache)
#     gateway   proxies HTTP only      ~0.4 GB
#     ---------------------------------------------------------------
#     both models resident            ~57 GB
#
# Two documented profiles:
#
#   >= 64 GB host:  docker compose up -d
#
#   >= 32 GB host:  IMAGEINT_IMAGE_QUANT=int8 docker compose up -d
#                   int8 halves the image pipeline to ~17 GB. Add
#                   IMAGEINT_PE_ENABLED=false to drop the enhancer as well;
#                   prompts are then used verbatim.
#
# Details in README.md, section "Speicherbudget".

# ── Public API of the gateway ─────────────────────────────────────────────────
# Host port the API is published on. LLMInt's image endpoint points here.
IMAGEINT_PORT=8080
# Shared secret. When set, clients must send it as X-Auth-Token (or
# "Authorization: Bearer ..."); requests without it get HTTP 401.
# Generate one with: openssl rand -hex 32
IMAGEINT_TOKEN=
# Absolute base URL the gateway advertises in status_url and image_url. Empty
# means "derive it from the request", which is right whenever LLMInt reaches the
# gateway under the same host:port it used for the call. Set it when a reverse
# proxy terminates TLS in front of the gateway, e.g.
# IMAGEINT_PUBLIC_URL=https://imageint.example.org
IMAGEINT_PUBLIC_URL=
# DEBUG / INFO / WARNING / ERROR. Prompts are logged at INFO, generated images
# never are.
IMAGEINT_LOG_LEVEL=INFO
# Image tag for the containers built from this repository.
IMAGEINT_IMAGE_TAG=local
# Memory ceiling of the gateway container; it only makes HTTP calls.
IMAGEINT_MEM_LIMIT=512m
# Host hardware check: auto / strict / off.
#   auto    (default) block a missing AVX2 only on bare metal; on a VM or in a
#           container it is a warning, because hypervisors mask CPUID flags and
#           Docker Desktop does not pass AVX2 through even on a capable CPU.
#   strict  always block, even on a VM. Only for hosts where the flags are
#           known to be trustworthy.
#   off     never block, only log. For exotic virtualisation that reports
#           nothing at all.
IMAGEINT_HOST_CHECK=auto

# ── Job handling ──────────────────────────────────────────────────────────────
# Upper length of a user prompt. Longer prompts are rejected with HTTP 400.
IMAGEINT_MAX_PROMPT_CHARS=4000
# How long one request may be answered synchronously. A CPU render of a 2K
# image takes minutes, so this is deliberately short: a job that is not done
# within this window answers 202 with a job id, and the caller polls it. LLMInt
# uses that window to decide whether to offer the e-mail notification.
IMAGEINT_SYNC_TIMEOUT=120
# Renders that run at the same time. A CPU host saturates with one; raise it
# only when the CPU has spare cores.
IMAGEINT_MAX_CONCURRENT_JOBS=1
# Requests that wait for a free slot. Beyond this the API answers 503 (busy)
# with Retry-After.
IMAGEINT_MAX_QUEUED_JOBS=2
# Job records kept in memory, and how long a finished job stays resolvable.
# The retention window must cover "user reads the notification mail and clicks
# the link", because that link is a job id.
IMAGEINT_MAX_JOBS=200
IMAGEINT_JOB_RETENTION_SECONDS=86400
# Directory inside the container where finished images are written. Backed by
# the imageint_data volume; the notification mail links to these files.
IMAGEINT_STORAGE_DIR=/data/images
# Loading contract (see README, section "Ladefortschritt").
# How long a readiness probe is cached, so polling /v1/ready stays cheap.
IMAGEINT_HEALTH_CACHE_SECONDS=5
# Seconds a 503 (service_loading) asks the client to wait before retrying.
IMAGEINT_LOADING_RETRY_AFTER=15
# How long a model server that has never answered counts as "still starting"
# instead of "broken". Must cover the first model download and the CPU warm-up.
IMAGEINT_STARTING_GRACE_SECONDS=1800

# ── Prompt enhancer (Qwen-Image-2.1-PE-T2I) ───────────────────────────────────
# Model id served by the enhancer container. Changing it means changing the
# weights, not just a label: the answer contract ("rewritten_prompt" plus
# "wh_ratio") is what the checkpoint was trained on, and the system prompt in
# gateway/app/prompts/ belongs to it.
#
# The value is the full repository id because the enhancer container passes it
# to transformers' from_pretrained, while the gateway sends it as the "model"
# field of the request. Both read this one variable.
IMAGEINT_PE_MODEL=Qwen/Qwen-Image-2.1-PE-T2I
# Pin a revision (branch, tag or commit) of the checkpoint. Empty = main.
IMAGEINT_PE_REVISION=
# Optional shared secret between gateway and enhancer. The gateway sends it as
# X-Auth-Token and as a bearer token; the enhancer accepts either spelling.
IMAGEINT_PE_TOKEN=
# Seconds the gateway waits for one enhancement.
IMAGEINT_PE_TIMEOUT=900
# false uses the user prompt verbatim and skips the enhancer entirely. This is
# the mode for a host that cannot keep both models in RAM, and the mode for
# debugging "is it the prompt or the model".
IMAGEINT_PE_ENABLED=true
# Override the vendored system prompt with a file on the gateway host.
IMAGEINT_PE_SYSTEM_PROMPT_FILE=
# Production sampling of the t2i enhancer, as documented by Qwen. They are not
# interchangeable with the edit task: a wrong presence penalty does not fail,
# it quietly changes the distribution that is sampled from.
IMAGEINT_PE_TEMPERATURE=1.0
IMAGEINT_PE_TOP_P=0.95
IMAGEINT_PE_TOP_K=20
IMAGEINT_PE_MIN_P=0.0
IMAGEINT_PE_PRESENCE_PENALTY=1.5
IMAGEINT_PE_MAX_NEW_TOKENS=16256
IMAGEINT_PE_SEED=42
# Context length of the enhancer server. Prompt plus answer must fit.
IMAGEINT_PE_CONTEXT=32768
# bfloat16 (documented) | float32 (no bf16 support, ~38 GB) | float16.
IMAGEINT_PE_DTYPE=bfloat16
# cpu (requirement) | cuda (prepared NVIDIA path) | mps.
IMAGEINT_PE_DEVICE=cpu
# none (bf16) | int8 | int4, applied through optimum-quanto.
IMAGEINT_PE_QUANT=none
# transformers is the only real engine; stub answers with a canned prompt and
# is meant for wiring tests and for the Docker documentation.
IMAGEINT_PE_ENGINE=transformers
# Load the weights at startup. Set to false on a 32 GB host that also runs the
# image pipeline: the container then stays idle until the gateway asks it to
# start loading through POST /v1/warmup, so nothing deadlocks.
IMAGEINT_PE_PRELOAD=true
# 0 leaves torch's default, which is one thread per core.
IMAGEINT_PE_CPU_THREADS=0
# The enhancer thinks before it answers. Off saves a lot of CPU time.
IMAGEINT_PE_ENABLE_THINKING=true
# Artificial delay of the stub engine, in seconds (IMAGEINT_PE_ENGINE=stub).
IMAGEINT_PE_STUB_DELAY=0
IMAGEINT_PE_LOG_LEVEL=INFO
# Memory ceiling of the enhancer container: 18.8 GB bf16 weights plus KV cache.
IMAGEINT_PE_MEM_LIMIT=24g
IMAGEINT_PE_MEM_RESERVATION=20g
IMAGEINT_PE_SHM=2g
IMAGEINT_PE_MEM_LIMIT_CUDA=16g
IMAGEINT_PE_MEM_RESERVATION_CUDA=8g

# ── Image model (Qwen-Image-2.1 via diffusers) ───────────────────────────────
# Served by image_server/: QwenImage21Pipeline from diffusers plus the text
# encoder and tokenizer from transformers, on the CPU. vLLM-Omni is not used,
# because it publishes GPU-only images and cannot satisfy the CPU-only
# requirement.
# The base checkpoint. Supplies tokenizer, text encoder, DiT, scheduler and VAE.
IMAGEINT_IMAGE_MODEL=Qwen/Qwen-Image-2.1
# Pin a revision (branch, tag or commit) of the checkpoint. Empty = main.
IMAGEINT_IMAGE_REVISION=
# none (bf16) | int8 | int4. bf16 is the documented format; int8 is the
# documented setting for a 32 GB host and uses about half the memory through
# optimum-quanto. int4 halves it again at a visible quality cost.
IMAGEINT_IMAGE_QUANT=none
# bfloat16 | float16 | float32. bfloat16 is what the model card documents.
# float32 doubles the footprint and is only for a CPU without bf16 support.
IMAGEINT_IMAGE_DTYPE=bfloat16
# cpu | cuda | mps. cpu is the requirement; cuda is the prepared NVIDIA path
# (docker-compose.cuda.yml); mps exists for a native Apple Silicon run.
IMAGEINT_IMAGE_DEVICE=cpu
# diffusers | stub. "stub" renders a placeholder image with Pillow and loads no
# weights - the mode for API and Docker tests without a model download.
IMAGEINT_IMAGE_ENGINE=diffusers
# Load the weights when the container starts. This is what makes the gateway's
# loading contract meaningful: /health answers 503 for the minutes it takes, and
# no request ever waits on a cold cache.
#
# false is only usable because the gateway nudges the image server through
# POST /v1/warmup while it reports 503: the container would otherwise stay idle
# forever, waiting for a render that the gateway refuses to send before /health
# returns 200. Clients see no difference - same 503, same Retry-After.
IMAGEINT_IMAGE_PRELOAD=true
# Torch intra-op threads. 0 leaves torch's default, which is one thread per
# core - the right value on the 8-core reference machine.
IMAGEINT_IMAGE_CPU_THREADS=0
# Optional shared secret between gateway and image server.
IMAGEINT_IMAGE_TOKEN=
# Seconds the gateway waits for one render. Denoising dominates and grows with
# the canvas, so this is generous.
IMAGEINT_IMAGE_TIMEOUT=1800
# Route the image is requested on. "images" is the OpenAI Images API that
# image_server implements; "chat" is a compatibility fallback for a deployment
# that fronts a chat-completions image model instead.
IMAGEINT_IMAGE_ROUTE=images
# Denoising steps and guidance. 40 steps is what the Qwen-Image-2.1 model card
# documents. Fewer steps are the cheapest way to make a CPU host faster; below
# ~20 the prompt adherence visibly degrades.
IMAGEINT_IMAGE_STEPS=40
# Qwen-Image-2.1 is trained to be sampled *without* guidance, hence 1.0. With
# true CFG > 1.0 the pipeline is run twice per step and a negative prompt takes
# effect; that roughly doubles the render time.
IMAGEINT_IMAGE_TRUE_CFG_SCALE=1.0
# Optional negative prompt sent with every render. Empty means "none": the
# enhancer already produces the negative description the model expects.
IMAGEINT_IMAGE_NEGATIVE_PROMPT=
# Largest canvas accepted, in pixels. The default is the largest of the seven
# documented ratios (2400x1792). 16:9 (2752x1536) fits under it; a larger
# request is scaled down to this budget and the applied size is reported back
# in the X-ImageInt-Width / -Height headers.
IMAGEINT_IMAGE_MAX_PIXELS=4300800
# Prefix KV cache of the DiT. Saves a lot of recomputation on a CPU host and is
# therefore on by default.
IMAGEINT_IMAGE_KV_CACHE=true
# Artificial delay of the stub engine, in seconds. Only meaningful with
# IMAGEINT_IMAGE_ENGINE=stub.
IMAGEINT_IMAGE_STUB_DELAY=0
# Memory ceiling of the image container: text encoder 17.5 GB bf16, DiT 14 GB,
# VAE 1.35 GB, plus activations for a 2400x1792 canvas.
IMAGEINT_MODEL_MEM_LIMIT=40g
IMAGEINT_MODEL_MEM_RESERVATION=34g
IMAGEINT_MODEL_SHM=2g
# CUDA only: fraction of VRAM the diffusion pipeline may use.
IMAGEINT_MODEL_GPU_UTILIZATION=0.90
IMAGEINT_MODEL_MEM_LIMIT_CUDA=16g
IMAGEINT_MODEL_MEM_RESERVATION_CUDA=8g

# ── Container images ──────────────────────────────────────────────────────────
# Build target of both model servers. "cpu" is the default of each Dockerfile
# and the reference deployment; "cuda" is selected by docker-compose.cuda.yml.
IMAGEINT_IMAGE_BUILD_TARGET=cpu
IMAGEINT_PE_BUILD_TARGET=cpu
# Local image tags. Bump them to force a rebuild of a cached layer.
IMAGEINT_IMAGE_TAG=local
IMAGEINT_PE_TAG=local
# Architecture of the model containers. linux/amd64 is the reference machine;
# set linux/arm64 for Apple Silicon, where the AVX2 part of the requirement does
# not apply and the gateway reports it as "entfällt".
IMAGEINT_IMAGE_PLATFORM=linux/amd64
IMAGEINT_PE_PLATFORM=linux/amd64
# Number of GPUs handed to the model containers, or "all".
IMAGEINT_GPU_COUNT=all

# ── Misc ──────────────────────────────────────────────────────────────────────
TZ=Europe/Berlin
